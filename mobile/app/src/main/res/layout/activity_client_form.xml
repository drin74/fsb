<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/etLastName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Фамилия *"
            android:inputType="textPersonName"
            android:textColor="@color/fsbtext"
            android:textColorHint="@color/fsbdim"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etFirstName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Имя *"
            android:inputType="textPersonName"
            android:textColor="@color/fsbtext"
            android:textColorHint="@color/fsbdim"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etMiddleName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Отчество"
            android:inputType="textPersonName"
            android:textColor="@color/fsbtext"
            android:textColorHint="@color/fsbdim"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etBirthDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Дата рождения (ДД.ММ.ГГГГ)"
            android:inputType="date"
            android:textColor="@color/fsbtext"
            android:textColorHint="@color/fsbdim"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etGender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Пол"
            android:inputType="textCapWords"
            android:textColor="@color/fsbtext"
            android:textColorHint="@color/fsbdim"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etCitizenship"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Гражданство"
            android:inputType="textCapWords"
            android:textColor="@color/fsbtext"
            android:textColorHint="@color/fsbdim"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etInn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ИНН"
            android:inputType="number"
            android:textColor="@color/fsbtext"
            android:textColorHint="@color/fsbdim"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etSnils"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="СНИЛС"
            android:inputType="number"
            android:textColor="@color/fsbtext"
            android:textColorHint="@color/fsbdim"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etPassportSeries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Серия паспорта"
            android:inputType="number"
            android:textColor="@color/fsbtext"
            android:textColorHint="@color/fsbdim"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etPassportNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Номер паспорта"
            android:inputType="number"
            android:textColor="@color/fsbtext"
            android:textColorHint="@color/fsbdim"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etPassportIssuedBy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Кем выдан"
            android:inputType="textCapWords"
            android:textColor="@color/fsbtext"
            android:textColorHint="@color/fsbdim"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etPassportIssueDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Дата выдачи (ДД.ММ.ГГГГ)"
            android:inputType="date"
            android:textColor="@color/fsbtext"
            android:textColorHint="@color/fsbdim"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Телефон"
            android:inputType="phone"
            android:textColor="@color/fsbtext"
            android:textColorHint="@color/fsbdim"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:textColor="@color/fsbtext"
            android:textColorHint="@color/fsbdim"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etAddressRegistration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Адрес регистрации"
            android:inputType="textPostalAddress"
            android:textColor="@color/fsbtext"
            android:textColorHint="@color/fsbdim"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etAddressActual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Адрес проживания"
            android:inputType="textPostalAddress"
            android:textColor="@color/fsbtext"
            android:textColorHint="@color/fsbdim"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Статус"
            android:inputType="textCapWords"
            android:textColor="@color/fsbtext"
            android:textColorHint="@color/fsbdim"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etRiskLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Уровень риска"
            android:inputType="textCapWords"
            android:textColor="@color/fsbtext"
            android:textColorHint="@color/fsbdim"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Источник"
            android:inputType="text"
            android:textColor="@color/fsbtext"
            android:textColorHint="@color/fsbdim"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Метки (через запятую)"
            android:inputType="textCapWords"
            android:textColor="@color/fsbtext"
            android:textColorHint="@color/fsbdim"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Примечания"
            android:minLines="3"
            android:inputType="textMultiLine"
            android:gravity="top"
            android:textColor="@color/fsbtext"
            android:textColorHint="@color/fsbdim"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:text="Сохранить" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
